{
  "name": "stayscape",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "npm --prefix api run start:dev",
    "start": "npm --prefix api run start:prod",
    "build": "vite build",
    "build:api": "npm --prefix api run build",
    "preview": "vite preview",
    "lint": "eslint .",
    "seed": "npm --prefix api run seed",
    "install:api": "npm --prefix api install",
    "postinstall": "npm --prefix api install"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.45.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  },
  "description": "Full-stack hotel booking platform — React + NestJS"
}
